#!/bin/sh

set -eu

firmware_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for archiver in \
    "$firmware_root"/.embuild/espressif/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-ar
do
    if [ -x "$archiver" ]; then
        exec "$archiver" "$@"
    fi
done

echo "ESP32-P4 archiver is missing; build esp-idf-sys once to install the toolchain" >&2
exit 1
