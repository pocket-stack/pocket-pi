#!/bin/sh

set -eu

firmware_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for compiler in \
    "$firmware_root"/.embuild/espressif/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-gcc
do
    if [ -x "$compiler" ]; then
        exec "$compiler" "$@"
    fi
done

echo "ESP32-P4 GCC is missing; build esp-idf-sys once to install the toolchain" >&2
exit 1
