#!/bin/sh

set -eu

firmware_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tools_root="$firmware_root/.embuild/espressif"
sysroot=
for candidate in \
    "$tools_root"/tools/xtensa-esp-elf/*/xtensa-esp-elf/xtensa-esp-elf
do
    if [ -f "$candidate/include/stdio.h" ]; then
        sysroot=$candidate
        break
    fi
done

if [ -z "$sysroot" ]; then
    cargo build --release -p esp-idf-sys
    for candidate in \
        "$tools_root"/tools/xtensa-esp-elf/*/xtensa-esp-elf/xtensa-esp-elf
    do
        if [ -f "$candidate/include/stdio.h" ]; then
            sysroot=$candidate
            break
        fi
    done
fi

if [ -z "$sysroot" ]; then
    echo "ESP32-S3 sysroot installation did not produce a usable toolchain" >&2
    exit 1
fi

bindgen_sysroot="--sysroot=$sysroot -isystem $sysroot/include"
if [ -n "${BINDGEN_EXTRA_CLANG_ARGS:-}" ]; then
    export BINDGEN_EXTRA_CLANG_ARGS="$bindgen_sysroot $BINDGEN_EXTRA_CLANG_ARGS"
else
    export BINDGEN_EXTRA_CLANG_ARGS="$bindgen_sysroot"
fi

exec cargo "$@"
