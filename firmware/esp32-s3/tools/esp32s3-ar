#!/bin/sh

set -eu

firmware_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for archiver in \
    "$firmware_root"/.embuild/espressif/tools/xtensa-esp-elf/*/xtensa-esp-elf/bin/xtensa-esp32s3-elf-ar
do
    if [ -x "$archiver" ]; then
        exec "$archiver" "$@"
    fi
done

echo "ESP32-S3 archiver is missing; build esp-idf-sys once to install the toolchain" >&2
exit 1
