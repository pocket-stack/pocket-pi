{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.pocket-pi-dashboard",
  "name": "pocket-pi-dashboard",
  "title": "Pocket Pi P4 Dashboard",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons"]
    }
  },
  "app": {
    "entry": "ui/dashboard/main.tsx",
    "output": "pocket-pi-dashboard",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 272],
        "presentation": "integer-fit"
      }
    }
  }
}
